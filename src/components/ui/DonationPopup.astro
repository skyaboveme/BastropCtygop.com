---
// DonationPopup.astro — Charge to Victory GOTV popup
---

<div id="donation-popup" class="fixed inset-0 z-50 flex flex-col items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300 hidden">
  <!-- Backdrop -->
  <div id="donation-popup-backdrop" class="absolute inset-0 bg-navy/80 backdrop-blur-sm transition-opacity"></div>
  
  <!-- Popup Content -->
  <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden transform scale-95 transition-transform duration-300" id="donation-popup-content">
    
    <!-- Close Button -->
    <button id="donation-popup-close" class="absolute top-3 right-3 bg-black/60 hover:bg-black/85 text-white rounded-full w-9 h-9 flex items-center justify-center transition-all z-20 shadow-md hover:scale-105 border border-white/20" aria-label="Close popup">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <!-- Image Link -->
    <a href="/events/charge-to-victory/" class="block group relative overflow-hidden">
      <img 
        src="/Assets/ChargetoVictoryLogo.png" 
        alt="Charge to Victory — Get Out the Vote Campaign" 
        width="800"
        height="500"
        loading="eager"
        decoding="async"
        class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.02]"
      />
      <!-- Hover overlay -->
      <div class="absolute inset-0 bg-navy/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
    </a>

    <!-- CTA Bar -->
    <div class="bg-navy p-4 text-center">
      <a href="/events/charge-to-victory/" class="inline-flex items-center gap-2 bg-red-primary hover:bg-red-dark text-white font-extrabold text-sm uppercase tracking-wider px-6 py-3 rounded-lg transition-all hover:-translate-y-0.5 shadow-lg">
        ★ Learn More & Volunteer
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const imgPreload = new Image();
    imgPreload.src = '/Assets/ChargetoVictoryLogo.png';

    const popup = document.getElementById('donation-popup');
    const backdrop = document.getElementById('donation-popup-backdrop');
    const content = document.getElementById('donation-popup-content');
    const closeBtn = document.getElementById('donation-popup-close');
    
    // Using a new key so all visitors see this popup fresh
    const hasSeenPopup = sessionStorage.getItem('bcrp_gotv_popup_v1');
    
    if (!hasSeenPopup && popup && backdrop && content && closeBtn) {
      setTimeout(() => {
        popup.classList.remove('hidden');
        
        requestAnimationFrame(() => {
          popup.classList.remove('opacity-0', 'pointer-events-none');
          content.classList.remove('scale-95');
          content.classList.add('scale-100');
        });
      }, 3000);
      
      const closePopup = () => {
        popup.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        
        sessionStorage.setItem('bcrp_gotv_popup_v1', 'true');
        
        setTimeout(() => {
          popup.classList.add('hidden');
        }, 300);
      };
      
      closeBtn.addEventListener('click', closePopup);
      backdrop.addEventListener('click', closePopup);
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !popup.classList.contains('hidden')) {
          closePopup();
        }
      });
    }
  });
</script>
