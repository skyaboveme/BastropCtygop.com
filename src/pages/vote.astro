---
import PageLayout from '../layouts/PageLayout.astro';

// All dates, hours, and locations are maintained by Bastrop County Elections.
const officialScheduleUrl = 'https://www.bastropvotes.org/voting-schedule/';
---

<PageLayout 
  title="Vote – Bastrop County Voting Schedule" 
  description="Find the official Bastrop County, TX voting schedule — early voting and Election Day dates, hours, and locations — from Bastrop County Elections."
>
  <!-- Hero Banner -->
  <section class="relative bg-navy py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,rgba(242,183,5,0.3),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_60%,rgba(183,36,54,0.2),transparent_50%)]"></div>
    </div>
    <div class="container mx-auto max-w-6xl px-4 relative z-10">
      <div class="text-center">
        <span class="inline-flex items-center gap-2 bg-red-primary/20 text-red-light px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 bg-red-light rounded-full animate-pulse"></span>
          Official Voting Information
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-6 leading-tight">
          Bastrop County<br/>
          <span class="text-gold">Voting Schedule</span>
        </h1>
        <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto mb-8 leading-relaxed">
          Get the official early voting and Election Day dates, hours, and locations directly from Bastrop County Elections. No excuses — make your voice heard.
        </p>
        <a
          href={officialScheduleUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="hero-official-schedule"
          class="inline-flex items-center gap-2 bg-red-primary hover:bg-red-dark text-white font-bold py-4 px-8 rounded-lg transition-all hover:scale-105 shadow-lg shadow-red-primary/25 text-lg"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          View Official Voting Schedule
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>
    </div>
  </section>

  <div class="bg-gray-50/50 py-16 lg:py-24">
    <div class="container mx-auto max-w-6xl px-4">

      <!-- Official Schedule Card -->
      <section id="voting-schedule" class="mb-20 scroll-mt-28">
        <a
          href={officialScheduleUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="official-schedule-card"
          class="group block bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >
          <div class="h-2 bg-gradient-to-r from-navy via-red-primary to-gold"></div>
          <div class="p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center gap-8 justify-between">
            <div class="flex items-start gap-5">
              <div class="w-16 h-16 rounded-xl bg-navy/10 flex items-center justify-center shrink-0">
                <svg class="w-8 h-8 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
              </div>
              <div>
                <h2 class="text-2xl md:text-3xl font-serif font-bold text-navy mb-3">Where &amp; When to Vote</h2>
                <p class="text-text-secondary leading-relaxed max-w-2xl">
                  Early voting and Election Day schedules, hours, and polling locations are set and published by Bastrop County Elections. Always check the official schedule for the most current information before you head to the polls.
                </p>
                <p class="mt-3 text-sm font-semibold text-red-primary">bastropvotes.org/voting-schedule</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-2 bg-navy group-hover:bg-red-primary text-white font-bold py-3.5 px-7 rounded-lg transition-colors shrink-0 shadow-md">
              Open Official Schedule
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </span>
          </div>
        </a>
      </section>

      <!-- ═══════════════════════════ VOTER ID ═══════════════════════════ -->
      <section id="voter-id" class="mb-16 scroll-mt-28">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-navy mb-8">Don't Forget Your ID</h2>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 md:p-8">
          <p class="text-text-secondary mb-6">Texas law requires one of these valid photo IDs to vote in person:</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              'Texas Driver License (DPS)',
              'Texas Election ID Certificate (DPS)',
              'Texas Personal ID Card (DPS)',
              'Texas Handgun License (DPS)',
              'U.S. Military ID with Photo',
              'U.S. Citizenship Certificate with Photo',
              'U.S. Passport (Book or Card)',
            ].map((id) => (
              <div class="flex items-center gap-3 p-3 rounded-lg bg-gray-50 border border-gray-100">
                <div class="w-6 h-6 rounded-full bg-navy/10 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5 text-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-sm font-medium text-navy">{id}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 p-4 bg-gold/10 border-l-4 border-gold rounded-r-lg">
            <p class="text-sm text-text-secondary">
              <strong class="text-navy">No ID?</strong> You may fill out a Reasonable Impediment Declaration at the polls and present an alternative form of ID such as a utility bill or bank statement.
            </p>
          </div>
        </div>
      </section>

      <!-- Bottom CTA -->
      <div class="text-center bg-navy rounded-2xl p-8 md:p-12 relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(242,183,5,0.08),transparent_70%)]"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-white mb-4">Ready to Vote?</h2>
          <p class="text-white/70 text-lg mb-8 max-w-lg mx-auto">Verify your registration, study the candidates, and show up. Your vote matters.</p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="https://teamrv-mvp.sos.texas.gov/MVP/mvp.do" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-red-primary hover:bg-red-dark text-white font-bold py-3.5 px-7 rounded-lg transition-colors shadow-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Check Registration
            </a>
            <a href={officialScheduleUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold py-3.5 px-7 rounded-lg transition-colors border border-white/20">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              Official Voting Schedule
            </a>
            <a href="/resources/voter-guide/" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold py-3.5 px-7 rounded-lg transition-colors border border-white/20">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
              View Voter Guide
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</PageLayout>
