---
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/ui/Card.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const latestPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const categories = [...new Set(allPosts.map((post) => post.data.category))].sort();

// Featured video links from Fox News and Not the Bee
const featuredVideos = [
  {
    title: "Trump Weighs Major Military Escalation Against Iran",
    source: "Fox News",
    url: "https://www.foxnews.com/category/world/conflicts/iran",
    description: "President Trump says U.S. is 'locked and loaded' as diplomatic talks with Iran continue alongside military operations.",
  },
  {
    title: "Patricia Heaton: Faith, Hollywood & Standing for Truth",
    source: "Not the Bee",
    url: "https://www.youtube.com/@NottheBee",
    description: "The beloved actress discusses navigating Hollywood as a conservative Christian and her evolving support for the Trump administration.",
  },
  {
    title: "Paxton vs. Talarico: Texas Senate Race Breakdown",
    source: "Fox 26 Houston",
    url: "https://www.fox26houston.com/",
    description: "Ken Paxton slams his Democratic opponent as hostile toward law enforcement as the general election race heats up.",
  },
];
---

<PageLayout
  title="News"
  description="Stay informed with the latest Republican news, Texas political updates, national security developments, and Bastrop County election announcements from the Bastrop County Republican Party."
>
  <section class="py-10 lg:py-16">
    <div class="container">
      <h1 class="text-3xl lg:text-4xl font-extrabold text-text-primary mb-2">Latest News</h1>
      <p class="text-text-secondary mb-8 max-w-2xl">Breaking stories, Texas political updates, and national news that matters to conservatives in Bastrop County. Sources include Fox News, Not the Bee, and more.</p>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        <!-- Main Content -->
        <div class="lg:col-span-3">

          <!-- Featured / Hero Post -->
          {latestPost && (
            <a href={`/news/${latestPost.id}/`} class="group block mb-10 bg-white rounded-xl border border-gray-medium overflow-hidden hover:shadow-[var(--shadow-card-hover)] transition-all duration-300">
              <div class="p-6 lg:p-8">
                <div class="flex items-center gap-3 mb-3">
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold text-white bg-red-primary px-3 py-1 rounded-full uppercase tracking-wider">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="5"/></svg>
                    Breaking
                  </span>
                  <span class="text-xs font-semibold text-red-primary bg-red-primary/10 px-2.5 py-1 rounded-full uppercase tracking-wide">
                    {latestPost.data.category}
                  </span>
                  <time datetime={new Date(latestPost.data.date).toISOString()} class="text-xs text-text-muted">
                    {new Date(latestPost.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                  </time>
                </div>
                <h2 class="text-2xl lg:text-3xl font-bold text-navy group-hover:text-red-primary transition-colors mb-3 leading-tight">
                  {latestPost.data.title}
                </h2>
                <p class="text-text-secondary text-base mb-4 max-w-3xl">{latestPost.data.excerpt}</p>
                <span class="text-sm font-semibold text-navy group-hover:text-red-primary transition-colors inline-flex items-center gap-1">
                  Read Full Story
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </a>
          )}

          <!-- Video & Media Section -->
          <div class="mb-10">
            <div class="flex items-center gap-2 mb-5">
              <svg class="w-5 h-5 text-red-primary" fill="currentColor" viewBox="0 0 20 20">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
              </svg>
              <h2 class="text-xl font-bold text-navy">Watch & Read</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {featuredVideos.map((video) => (
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col bg-white rounded-xl border border-gray-medium overflow-hidden hover:shadow-[var(--shadow-card-hover)] hover:border-red-primary/30 transition-all duration-300"
                >
                  <div class="bg-navy/5 p-4 flex items-center justify-center min-h-[80px]">
                    <div class="w-12 h-12 rounded-full bg-red-primary/10 group-hover:bg-red-primary/20 flex items-center justify-center transition-colors">
                      <svg class="w-6 h-6 text-red-primary" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                      </svg>
                    </div>
                  </div>
                  <div class="p-4 flex-1 flex flex-col">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-red-primary mb-1.5">{video.source}</span>
                    <h3 class="text-sm font-bold text-text-primary group-hover:text-navy transition-colors mb-2 leading-snug">{video.title}</h3>
                    <p class="text-xs text-text-secondary line-clamp-2 mt-auto">{video.description}</p>
                    <span class="text-xs font-semibold text-navy group-hover:text-red-primary mt-3 inline-flex items-center gap-1 transition-colors">
                      Watch Now
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- All Stories Grid -->
          <div class="flex items-center gap-2 mb-5">
            <span class="w-2 h-2 bg-red-primary rounded-full"></span>
            <h2 class="text-xl font-bold text-navy">All Stories</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="news-grid">
            {remainingPosts.map((post) => (
              <div data-category={post.data.category}>
                <Card
                  title={post.data.title}
                  href={`/news/${post.id}/`}
                  excerpt={post.data.excerpt}
                  date={new Date(post.data.date)}
                  category={post.data.category}
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">

            <!-- News Sources -->
            <div class="bg-gray-light rounded-xl p-5">
              <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider mb-4">Our Sources</h2>
              <div class="space-y-3">
                <a href="https://www.foxnews.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-navy hover:text-red-primary transition-colors group">
                  <div class="w-8 h-8 rounded-lg bg-white shadow-sm flex items-center justify-center shrink-0 group-hover:shadow-md transition-shadow">
                    <span class="text-xs font-black text-navy">FOX</span>
                  </div>
                  Fox News
                  <svg class="w-3 h-3 ml-auto opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
                <a href="https://notthebee.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-navy hover:text-red-primary transition-colors group">
                  <div class="w-8 h-8 rounded-lg bg-white shadow-sm flex items-center justify-center shrink-0 group-hover:shadow-md transition-shadow">
                    <span class="text-xs font-black text-amber-600">NTB</span>
                  </div>
                  Not the Bee
                  <svg class="w-3 h-3 ml-auto opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
                <a href="https://www.foxbusiness.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-navy hover:text-red-primary transition-colors group">
                  <div class="w-8 h-8 rounded-lg bg-white shadow-sm flex items-center justify-center shrink-0 group-hover:shadow-md transition-shadow">
                    <span class="text-xs font-black text-navy">FBN</span>
                  </div>
                  Fox Business
                  <svg class="w-3 h-3 ml-auto opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Categories -->
            <div class="bg-gray-light rounded-xl p-5">
              <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider mb-4">Categories</h2>
              <ul class="space-y-2">
                {categories.map((cat) => (
                  <li>
                    <a
                      href={`/news/category/${cat.toLowerCase().replace(/\s+/g, '-')}/`}
                      class="text-sm text-navy hover:text-red-primary transition-colors flex items-center justify-between"
                    >
                      {cat}
                      <span class="text-xs text-text-muted bg-white px-2 py-0.5 rounded-full">
                        {allPosts.filter((p) => p.data.category === cat).length}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Donate CTA -->
            <div class="bg-red-primary rounded-xl p-5 text-center">
              <h3 class="text-white font-bold mb-2">Support BCRP</h3>
              <p class="text-white/80 text-sm mb-4">Your donation helps us promote conservative values.</p>
              <a
                href="https://square.link/u/p4rKmX9I"
                target="_blank"
                rel="noopener noreferrer"
                class="block bg-white text-red-primary font-semibold text-sm px-4 py-2.5 rounded-lg hover:bg-gray-light transition-colors"
              >
                Donate Today
              </a>
            </div>

            <!-- Subscribe CTA -->
            <div class="bg-navy rounded-xl p-5 text-center">
              <h3 class="text-white font-bold mb-2">Stay Informed</h3>
              <p class="text-white/70 text-sm mb-4">Get updates delivered straight to your inbox.</p>
              <a
                href="/newsletter/"
                class="block bg-white text-navy font-semibold text-sm px-4 py-2.5 rounded-lg hover:bg-gray-light transition-colors"
              >
                Subscribe to Newsletter
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>
