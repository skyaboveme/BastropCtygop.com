---
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/ui/Card.astro';
import LiveNewsFeed from '../../components/sections/LiveNewsFeed.astro';


// All conservative news sources
const newsSources = [
  { name: 'Fox News', abbr: 'FOX', color: 'text-navy', url: 'https://www.foxnews.com/' },
  { name: 'Fox Business', abbr: 'FBN', color: 'text-navy', url: 'https://www.foxbusiness.com/' },
  { name: 'Not the Bee', abbr: 'NTB', color: 'text-amber-600', url: 'https://notthebee.com/' },
  { name: 'Daily Wire', abbr: 'DW', color: 'text-sky-700', url: 'https://www.dailywire.com/' },
  { name: 'The Blaze', abbr: 'BLZ', color: 'text-orange-600', url: 'https://www.theblaze.com/' },
  { name: 'Breitbart', abbr: 'BB', color: 'text-orange-700', url: 'https://www.breitbart.com/' },
  { name: 'Babylon Bee', abbr: '🐝', color: 'text-amber-500', url: 'https://babylonbee.com/' },
  { name: 'Epoch Times', abbr: 'ET', color: 'text-blue-800', url: 'https://www.theepochtimes.com/' },
  { name: 'Newsmax', abbr: 'NM', color: 'text-blue-600', url: 'https://www.newsmax.com/' },
  { name: 'PragerU', abbr: 'PU', color: 'text-indigo-700', url: 'https://www.prageru.com/' },
  { name: 'The Federalist', abbr: 'FED', color: 'text-emerald-700', url: 'https://thefederalist.com/' },
  { name: 'Texas Scorecard', abbr: 'TXS', color: 'text-red-700', url: 'https://texasscorecard.com/' },
  { name: 'The Texan', abbr: 'TXN', color: 'text-blue-900', url: 'https://thetexan.news/' },
];
---

<PageLayout
  title="News"
  description="Stay informed with the latest Republican news, Texas political updates, national security developments, and Bastrop County election announcements from the Bastrop County Republican Party."
>
  <section class="py-10 lg:py-16">
    <div class="container">
      <h1 class="text-3xl lg:text-4xl font-extrabold text-text-primary mb-2">Latest News</h1>
      <p class="text-text-secondary mb-8 max-w-2xl">Breaking stories, Texas political updates, and national news that matters to conservatives in Bastrop County. Live headlines from Fox News, The Daily Wire, Not the Bee, and more.</p>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        <!-- Main Content -->
        <div class="lg:col-span-3">

          <!-- Live Conservative News Feed -->
          <LiveNewsFeed />
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-24 space-y-6">

            <!-- News Sources -->
            <div class="bg-gray-light rounded-xl p-5">
              <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider mb-4">Our Sources</h2>
              <div class="space-y-2.5">
                {newsSources.map((source) => (
                  <a href={source.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-navy hover:text-red-primary transition-colors group">
                    <div class="w-8 h-8 rounded-lg bg-white shadow-sm flex items-center justify-center shrink-0 group-hover:shadow-md transition-shadow">
                      <span class={`text-[10px] font-black ${source.color}`}>{source.abbr}</span>
                    </div>
                    <span class="flex-1 truncate">{source.name}</span>
                    <svg class="w-3 h-3 opacity-30 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ))}
              </div>
            </div>



            <!-- Donate CTA -->
            <div class="bg-red-primary rounded-xl p-5 text-center">
              <h3 class="text-white font-bold mb-2">Support BCRP</h3>
              <p class="text-white/80 text-sm mb-4">Your donation helps us promote conservative values.</p>
              <a
                href="https://square.link/u/p4rKmX9I"
                target="_blank"
                rel="noopener noreferrer"
                class="block bg-white text-red-primary font-semibold text-sm px-4 py-2.5 rounded-lg hover:bg-gray-light transition-colors"
              >
                Donate Today
              </a>
            </div>

            <!-- Subscribe CTA -->
            <div class="bg-navy rounded-xl p-5 text-center">
              <h3 class="text-white font-bold mb-2">Stay Informed</h3>
              <p class="text-white/70 text-sm mb-4">Get updates delivered straight to your inbox.</p>
              <a
                href="/newsletter/"
                class="block bg-white text-navy font-semibold text-sm px-4 py-2.5 rounded-lg hover:bg-gray-light transition-colors"
              >
                Subscribe to Newsletter
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>
