const categoryLabels = {
  statewide: 'Statewide Party',
  policy: 'Policy & Research',
  grassroots: 'Grassroots & Advocacy',
  'county-gop': 'County GOP',
  'local-groups': 'Local Groups & PACs'
};

function getDisplayUrl(urlString) {
  try {
    const url = new URL(urlString);
    return url.hostname.replace('www.', '');
  } catch (e) {
    return urlString;
  }
}

const directorySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Texas Conservative Directory - Bastrop County Republican Party",
  "description": "Comprehensive directory of Republican and conservative organizations, county party sites, and independent advocacy groups in Texas.",
  "publisher": {
    "@type": "PoliticalParty",
    "name": "Bastrop County Republican Party",
    "url": "https://bastropctygop.com"
  }
};
---

<PageLayout 
  title="Texas Conservative Directory" 
  description="A comprehensive listing of Republican Party organizations, conservative research institutes, grassroots advocacy groups, and local county party websites across Texas."
  jsonLd={directorySchema}
>
  <div class="bg-gray-50/50 py-12 lg:py-16 min-h-screen">
    <div class="container mx-auto px-4 max-w-7xl">
      
      <!-- Page Header -->
      <div class="mb-10 text-center lg:text-left border-b border-gray-200 pb-6">
        <h1 class="text-3xl md:text-5xl font-serif font-bold text-navy mb-4 inline-block relative">
          Texas Conservative Directory
          <div class="absolute -bottom-2 left-0 w-1/4 h-1 bg-red-primary rounded-full"></div>
        </h1>
        <p class="text-text-secondary text-base md:text-lg leading-relaxed mt-2 max-w-3xl">
          A compiled reference list of conservative organizations, policy institutes, and Republican County Parties with published websites throughout the State of Texas.
        </p>
        <p class="text-xs text-text-muted mt-4">
          Compiled August 12, 2026. Sources: Republican Party of Texas Leadership Directory (<a href="https://texasgop.org" target="_blank" rel="noopener noreferrer" class="hover:text-red-primary underline">texasgop.org</a>) and each organization’s official website.
        </p>
      </div>

      <!-- Controls: Search & Category Tabs -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8 space-y-6">
        
        <!-- Search bar -->
        <div class="relative max-w-xl">
          <label for="directory-search" class="sr-only">Search organizations by name or county</label>
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="search"
            id="directory-search"
            class="block w-full pl-10 pr-4 py-3 border border-gray-200 rounded-lg text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-navy focus:border-transparent outline-none transition-all placeholder:text-text-muted"
            placeholder="Search organizations or counties (e.g. Bastrop, Fayette, Cruz)..."
          />
        </div>

        <!-- Filter tabs -->
        <div>
          <span class="block text-xs font-bold uppercase tracking-widest text-text-secondary mb-3">Filter by Category</span>
          <div class="flex flex-wrap gap-2" id="filter-tabs" role="tablist" aria-label="Category Filters">
            <button
              role="tab"
              aria-selected="true"
              data-filter="all"
              class="px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all shadow-sm bg-red-primary text-white border border-red-primary cursor-pointer"
            >
              All ({organizations.length})
            </button>
            <button
              role="tab"
              aria-selected="false"
              data-filter="statewide"
              class="px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all shadow-sm bg-white text-navy border border-gray-200 hover:bg-gray-50 cursor-pointer"
            >
              Party & Programs ({organizations.filter(o => o.category === 'statewide').length})
            </button>
            <button
              role="tab"
              aria-selected="false"
              data-filter="policy"
              class="px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all shadow-sm bg-white text-navy border border-gray-200 hover:bg-gray-50 cursor-pointer"
            >
              Policy & Research ({organizations.filter(o => o.category === 'policy').length})
            </button>
            <button
              role="tab"
              aria-selected="false"
              data-filter="grassroots"
              class="px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all shadow-sm bg-white text-navy border border-gray-200 hover:bg-gray-50 cursor-pointer"
            >
              Grassroots & Advocacy ({organizations.filter(o => o.category === 'grassroots').length})
            </button>
            <button
              role="tab"
              aria-selected="false"
              data-filter="county-gop"
              class="px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all shadow-sm bg-white text-navy border border-gray-200 hover:bg-gray-50 cursor-pointer"
            >
              County GOP ({organizations.filter(o => o.category === 'county-gop').length})
            </button>
            <button
              role="tab"
              aria-selected="false"
              data-filter="local-groups"
              class="px-4 py-2 rounded-lg text-xs md:text-sm font-bold transition-all shadow-sm bg-white text-navy border border-gray-200 hover:bg-gray-50 cursor-pointer"
            >
              Local Groups & PACs ({organizations.filter(o => o.category === 'local-groups').length})
            </button>
          </div>
        </div>
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-16 bg-white rounded-xl border border-gray-100 shadow-sm max-w-xl mx-auto">
        <svg class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-lg font-bold text-navy">No organizations found</h3>
        <p class="text-sm text-text-secondary mt-2">Try adjusting your search keywords or choosing a different category filter.</p>
        <button id="reset-search" class="mt-5 inline-flex items-center gap-2 bg-navy hover:bg-navy-light text-white font-bold text-xs py-2.5 px-4 rounded-lg transition-colors cursor-pointer">
          Reset Search
        </button>
      </div>

      <!-- Organizations Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6" id="directory-grid">
        {organizations.map((org) => (
          <div 
            class="bg-white rounded-xl border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-[var(--shadow-card-hover)] transition-all duration-300 flex flex-col justify-between overflow-hidden relative group"
            data-category={org.category}
            data-name={org.name.toLowerCase()}
          >
            <!-- Border strip representing level -->
            <div class={`absolute top-0 left-0 w-full h-1.5 ${
              org.category === 'statewide' ? 'bg-navy' : 
              org.category === 'policy' ? 'bg-red-primary' : 
              org.category === 'grassroots' ? 'bg-red-light' : 
              org.category === 'county-gop' ? 'bg-gold' : 'bg-gray-400'
            }`}></div>

            <div class="p-6 md:p-8 space-y-3 mt-1">
              <!-- Styled badge -->
              <span class={`inline-block text-[9px] font-extrabold uppercase tracking-widest px-2 py-0.5 rounded ${
                org.category === 'statewide' ? 'bg-navy/10 text-navy' : 
                org.category === 'policy' ? 'bg-red-primary/10 text-red-primary' : 
                org.category === 'grassroots' ? 'bg-red-light/10 text-red-light' : 
                org.category === 'county-gop' ? 'bg-gold/15 text-navy' : 'bg-gray-100 text-text-secondary'
              }`}>
                {categoryLabels[org.category]}
              </span>
              
              <h2 class="text-lg font-bold text-navy leading-tight group-hover:text-red-primary transition-colors min-h-[44px] flex items-center">
                {org.name}
              </h2>
            </div>

            <!-- External Link Footer -->
            <div class="px-6 py-4 md:px-8 bg-gray-50/50 border-t border-gray-50 flex items-center justify-between text-xs">
              <span class="font-mono text-[11px] text-text-secondary block truncate max-w-[170px]" title={org.url}>
                {getDisplayUrl(org.url)}
              </span>
              
              <a 
                href={org.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1 font-bold text-navy hover:text-red-primary transition-colors py-1.5 px-3 rounded-md hover:bg-navy/5 cursor-pointer"
              >
                Visit Site
                <svg class="w-3.5 h-3.5 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</PageLayout>

<script>
  // DOM Elements
  const searchInput = document.getElementById('directory-search') as HTMLInputElement;
  const filterTabs = document.getElementById('filter-tabs')?.querySelectorAll('button');
  const directoryGrid = document.getElementById('directory-grid');
  const cards = directoryGrid?.querySelectorAll('[data-category]');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-search');

  let activeFilter = 'all';
  let searchQuery = '';

  function filterDirectory() {
    let visibleCount = 0;

    cards?.forEach((card) => {
      const category = card.getAttribute('data-category');
      const name = card.getAttribute('data-name') || '';

      const matchesFilter = activeFilter === 'all' || category === activeFilter;
      const matchesSearch = name.includes(searchQuery);

      if (matchesFilter && matchesSearch) {
        (card as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    // Handle empty state
    if (visibleCount === 0) {
      noResults?.classList.remove('hidden');
      directoryGrid?.classList.add('hidden');
    } else {
      noResults?.classList.add('hidden');
      directoryGrid?.classList.remove('hidden');
    }
  }

  // Handle Search Input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    filterDirectory();
  });

  // Handle Category Tabs
  filterTabs?.forEach((tab) => {
    tab.addEventListener('click', () => {
      activeFilter = tab.getAttribute('data-filter') || 'all';

      // Update button visual styles
      filterTabs.forEach((btn) => {
        btn.classList.remove('bg-red-primary', 'text-white', 'border-red-primary');
        btn.classList.add('bg-white', 'text-navy', 'border-gray-200', 'hover:bg-gray-50');
        btn.setAttribute('aria-selected', 'false');
      });

      tab.classList.remove('bg-white', 'text-navy', 'border-gray-200', 'hover:bg-gray-50');
      tab.classList.add('bg-red-primary', 'text-white', 'border-red-primary');
      tab.setAttribute('aria-selected', 'true');

      filterDirectory();
    });
  });

  // Reset Button Click
  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    
    // Reset to "All" category tab
    const allTab = document.querySelector('[data-filter="all"]') as HTMLButtonElement;
    if (allTab) allTab.click();
    
    filterDirectory();
  });
</script>
